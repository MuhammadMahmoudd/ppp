# Copy to .env and fill in. These are PUBLIC values (safe in the app bundle).
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Filled automatically by `npx eas-cli init` (Expo project id, used for push + updates)
EAS_PROJECT_ID=
