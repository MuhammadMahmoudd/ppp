# Web build on Cloudflare: leave EXPO_PUBLIC_API_URL empty — the app and the
# API are served from the same Worker/domain.
#
# Local development (Expo web on :8081 talking to `npm run dev:api` on :8787):
#   EXPO_PUBLIC_API_URL=http://localhost:8787
#
# iPhone app (later): your Worker's URL, e.g.
#   EXPO_PUBLIC_API_URL=https://dildar.<your-subdomain>.workers.dev
EXPO_PUBLIC_API_URL=

# Filled by `npx eas-cli init` (only needed for the iPhone app / push)
EAS_PROJECT_ID=
